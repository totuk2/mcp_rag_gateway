# MCP Gateway + Tool-RAG configuration.
# Copy to `.env` (gitignored) and adjust. Loaded by `docker compose up` via the
# gateway service's `env_file`. Values here are the application defaults — every
# line is optional; delete what you don't override.

# ── Gateway ──────────────────────────────────────────────────────────────────
MCP_GATEWAY_CONFIG_DIR=/app/config          # in-container config dir (matches the volume mount)
MCP_GATEWAY_REGISTRY=registry.yaml
MCP_GATEWAY_REGISTRY_GENERATED=registry.generated.yaml
MCP_GATEWAY_KEYS=keys.yaml
MCP_GATEWAY_MCP_PATH=/mcp
MCP_GATEWAY_HOST=0.0.0.0
MCP_GATEWAY_PORT=8765
GATEWAY_ANON_KEY=anon                        # key id from keys.yaml for unauthenticated clients; empty = disabled
UVICORN_LOG_LEVEL=info

# ── Tool-RAG ─────────────────────────────────────────────────────────────────
TOOL_RAG_ENABLED=1
TOOL_RAG_DB=tool_registry.db
TOOL_RAG_WITHOUT_AUTH=0
TOOL_RAG_STARTUP_REINDEX=full                # full | incremental | off
TOOL_RAG_HEALTHCHECK_INTERVAL=30             # seconds; 0 disables
TOOL_RAG_HEALTHCHECK_TIMEOUT=5
TOOL_RAG_RESYNC_INTERVAL=0                    # seconds; 0 = off

# ── Embedder ─────────────────────────────────────────────────────────────────
TOOL_RAG_EMBEDDER=local                      # local | url
# Remote (url) embedder — e.g. Ollama serving Qwen3-Embedding:
# TOOL_RAG_EMBEDDER=url
# TOOL_RAG_EMBED_URL=http://ollama:11434/v1/embeddings
# TOOL_RAG_EMBED_MODEL=hf.co/Qwen/Qwen3-Embedding-0.6B-GGUF:Q8_0
# TOOL_RAG_EMBED_DIM=1024                     # set to skip the boot-time probe
# TOOL_RAG_EMBED_API_KEY=                     # optional; omit for keyless Ollama

# ── Reranker ─────────────────────────────────────────────────────────────────
TOOL_RAG_RERANKER=off                        # off | local (cross-encoder rerank)
# TOOL_RAG_RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
